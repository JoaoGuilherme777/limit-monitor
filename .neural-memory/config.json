{
  "project_root": ".",
  "index_mode": "both",
  "languages": [
    "auto"
  ],
  "include_patterns": [
    "auto"
  ],
  "exclude_patterns": [
    "**/.git/**",
    "**/migrations/**",
    "**/.neural-memory/**",
    "**/__pycache__/**",
    "**/*.egg-info/**",
    "**/.venv/**",
    "**/venv/**",
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/.next/**",
    "**/coverage/**",
    "**/target/**",
    "**/.cargo/**",
    "**/vendor/**",
    "**/pkg/**",
    "**/bin/**",
    "**/obj/**",
    "**/Pods/**"
  ],
  "redaction": {
    "enabled": true,
    "builtin_patterns": true,
    "sensitive_var_patterns": [
      "(?i)(secret|password|passwd|pwd|token|api_key|apikey|auth|credential|private_key|access_key)"
    ],
    "custom_patterns": [],
    "whitelist_vars": []
  },
  "max_summary_short_chars": 200,
  "max_summary_detailed_chars": 1000,
  "staleness_threshold": 5,
  "importance_threshold": 0.2,
  "lsp_enabled": true,
  "lsp_servers": {}
}