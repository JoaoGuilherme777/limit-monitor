<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Limit Monitor User</label>
    <hasActivationRequired>false</hasActivationRequired>
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Limit_Snapshot__c</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>
    <!-- Limit_Name__c, Used__c e Maximum__c são obrigatórios: o acesso a eles é implícito, não entra no permission set. -->
    <fieldPermissions>
        <editable>false</editable>
        <field>Limit_Snapshot__c.Percent_Used__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Limit_Snapshot__c.Captured_At__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Limit_Snapshot__c.Snapshot_Date__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <classAccesses>
        <apexClass>LimitMonitorController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
</PermissionSet>
